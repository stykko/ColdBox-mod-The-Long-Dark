<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game path: edit GameDir.props (next to the .sln) -->
  <Import Project="..\GameDir.props" Condition="Exists('..\GameDir.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ColdBox</AssemblyName>
    <RootNamespace>ColdBox</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- net6.0 is what MelonLoader 0.7.2 runs on; newer SDKs only warn that it is out of support -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\TheLongDark</GameDir>
    <ML>$(GameDir)\MelonLoader</ML>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader 0.7.2 -->
    <Reference Include="MelonLoader"><HintPath>$(ML)\net6\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ML)\net6\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(ML)\net6\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(ML)\net6\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>

    <!-- Assemblies generated by MelonLoader from the game (they exist after running the game once with MelonLoader) -->
    <Reference Include="Il2Cppmscorlib"><HintPath>$(ML)\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ML)\Il2CppAssemblies\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Types that appear in signatures of the game API (Wwise audio events, Addressables asset references) -->
    <Reference Include="Il2CppAK.Wwise.Unity.API.WwiseTypes"><HintPath>$(ML)\Il2CppAssemblies\Il2CppAK.Wwise.Unity.API.WwiseTypes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(ML)\Il2CppAssemblies\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager" Condition="Exists('$(ML)\Il2CppAssemblies\Unity.ResourceManager.dll')"><HintPath>$(ML)\Il2CppAssemblies\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ML)\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="Il2CppTLD.PDID" Condition="Exists('$(ML)\Il2CppAssemblies\Il2CppTLD.PDID.dll')"><HintPath>$(ML)\Il2CppAssemblies\Il2CppTLD.PDID.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppTLD.IntBackedUnit"><HintPath>$(ML)\Il2CppAssemblies\Il2CppTLD.IntBackedUnit.dll</HintPath><Private>false</Private></Reference>

    <!-- Mod that must already be installed in Mods\ (options menu) -->
    <Reference Include="ModSettings"><HintPath>$(GameDir)\Mods\ModSettings.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Mesh, metadata and texture are embedded INSIDE the DLL -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\parts.bin" LogicalName="ColdBox.parts.bin" />
    <EmbeddedResource Include="Resources\meta.txt"  LogicalName="ColdBox.meta.txt" />
    <EmbeddedResource Include="Resources\texture.jpg" LogicalName="ColdBox.texture.jpg" />
    <EmbeddedResource Include="Resources\crafteo.png" LogicalName="ColdBox.crafteo.png" />
    <EmbeddedResource Include="Resources\mist1.png" LogicalName="ColdBox.mist1.png" />
    <EmbeddedResource Include="Resources\mist2.png" LogicalName="ColdBox.mist2.png" />
    <EmbeddedResource Include="Resources\mist3.png" LogicalName="ColdBox.mist3.png" />
    <EmbeddedResource Include="Resources\icon_close.png" LogicalName="ColdBox.icon_close.png" />
    <EmbeddedResource Include="Resources\icon_snow.png" LogicalName="ColdBox.icon_snow.png" />
    <EmbeddedResource Include="Resources\icon_frozen.png" LogicalName="ColdBox.icon_frozen.png" />
    <EmbeddedResource Include="Resources\iconoblanco.png" LogicalName="ColdBox.iconoblanco.png" />
    <EmbeddedResource Include="Resources\texture_snow.jpg" LogicalName="ColdBox.texture_snow.jpg" />
  </ItemGroup>

  <!-- After building (Ctrl+Shift+B) the DLL is copied to <game>\Mods -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)ColdBox.dll" DestinationFolder="$(GameDir)\Mods" Condition="Exists('$(GameDir)\Mods')" />
    <Message Importance="high" Text="ColdBox.dll copied to $(GameDir)\Mods" Condition="Exists('$(GameDir)\Mods')" />
    <Warning Text="$(GameDir)\Mods does not exist: fix the path in GameDir.props" Condition="!Exists('$(GameDir)\Mods')" />
  </Target>

</Project>
